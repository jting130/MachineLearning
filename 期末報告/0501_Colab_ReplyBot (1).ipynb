ngrok_authtoken = userdata.get('NGROK_AUTHTOKEN')            # Ngrok 的身份驗證金鑰
line_channel_access_token = userdata.get('LINE_CHANNEL_ACCESS_TOKEN') # LINE Bot 的頻道存取權杖
line_channel_secret = userdata.get('LINE_CHANNEL_SECRET')     # LINE Bot 的頻道密鑰
