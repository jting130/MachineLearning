# 設定 Flask 與 Ngrok 互相綁定的本機連接埠 (Port)
port = 5051
import os
from pyngrok import ngrok
# 強制關閉目前所有正在執行的 Ngrok 隧道
# 這樣可以避免重複執行 Cell 時，因為舊連線未關閉而導致 Ngrok 帳號超過連線數限制的錯誤
ngrok.kill()
import requests

# 1. 驗證並設定 Ngrok Token
ngrok.set_auth_token(ngrok_authtoken)

# 2. 開啟一個對應到本機 Port 5051 的網路隧道，並命名為 linebot_tunnel
tunnel = ngrok.connect(5051, name="linebot_tunnel")

# 3. 取得 Ngrok 產生的公網網址 (例如 https://xxxx.ngrok-free.app)
webhook_url = tunnel.public_url

print(f"Ngrok URL: {webhook_url}")

# 自動更新 LINE Webhook URL 的函式
def update_line_webhook(webhook_url):
    """使用 LINE Messaging API 直接更新 LINE Developer 後台的 Webhook Endpoint"""
    url = "https://api.line.me/v2/bot/channel/webhook/endpoint"
    
    # 設定帶有 LINE Token 的標頭
    headers = {
        "Authorization": f"Bearer {line_channel_access_token}",
        "Content-Type": "application/json"
    }
    
    # 準備發送給 LINE API 的資料，指定新的 Webhook 網址
    data = {
        "endpoint": webhook_url
    }
    
    # 向 LINE 伺服器發送 PUT 請求來修改設定
    response = requests.put(url, headers=headers, json=data)
    
    # 根據回傳狀態碼判斷是否成功
    if response.status_code == 200:
        print(f"✅ LINE Webhook URL 已自動更新為：{webhook_url}")
        return True
    else:
        print(f"❌ 更新失敗：{response.status_code} - {response.text}")
        return False

# 執行更新函式
update_line_webhook(webhook_url)
from flask import Flask, request, abort

# 匯入 LINE v3 版 SDK 的必要元件
from linebot.v3 import (
    WebhookHandler
)
from linebot.v3.exceptions import (
    InvalidSignatureError
)
from linebot.v3.messaging import (
    Configuration,
    ApiClient,
    MessagingApi,
    ReplyMessageRequest,
    TextMessage,
)
from linebot.v3.webhooks import (
    MessageEvent,
    TextMessageContent,
)

# 初始化 Flask 應用程式
app = Flask(__name__)

# 配置 LINE Bot 的憑證
configuration = Configuration(access_token=line_channel_access_token)
handler = WebhookHandler(line_channel_secret)

# 設定 Flask 的根路由（處理 LINE 傳過來的 Webhook 請求）
@app.route("/", methods=['POST'])
def callback():
    # 取得 LINE 訊息標頭中的數位簽章，用來驗證請求是否真的來自 LINE 官方伺服器
    signature = request.headers['X-Line-Signature']

    # 取得請求的文字內容 (JSON 格式字串)
    body = request.get_data(as_text=True)
    print("BODY: ", body)
    app.logger.info("Request body: " + body)

    # 處理 Webhook 訊息主體
    try:
        handler.handle(body, signature) # 交給後續定義的 handler 去觸發對應的事件
    except InvalidSignatureError:
        # 如果簽章驗證失敗，代表這不是 LINE 官方發送的合法請求
        app.logger.info("Invalid signature. Please check your channel access token/channel secret.")
        abort(400) # 回傳 HTTP 400 錯誤

    return 'OK' # 驗證與處理成功，回傳 OK 給 LINE 伺服器


# 當收到「文字訊息」事件時的處理邏輯 (MessageEvent 且內容是 TextMessageContent)
@handler.add(MessageEvent, message=TextMessageContent)
def handle_message(event):
    print("EVENT: ", event)
    
    # 使用 ApiClient 與配置建立與 LINE API 通訊的實例
    with ApiClient(configuration) as api_client:
        line_bot_api = MessagingApi(api_client)
        
        # 💡【0501作業核心說明：為什麼 LINE 會回應兩次？】
        # 在 ReplyMessageRequest 的 messages 陣列參數中，我們傳入了兩個 TextMessage 物件。
        # LINE Messaging API 允許在單次的回覆（使用同一個 reply_token）中，同時打包發送最多 5 則訊息。
        # 因為這裡陣列內重複寫了兩次 `TextMessage(text=event.message.text)`，
        # 所以當使用者傳送一條訊息過來時，LINE 伺服器就會在同一個時間點連續吐回兩條一模一樣的訊息給使用者。
        line_bot_api.reply_message_with_http_info(
            ReplyMessageRequest(
                reply_token=event.reply_token, # 使用該次事件獨有的 reply_token（只能用一次）
                messages=[
                    TextMessage(text=event.message.text), # 第一條訊息：使用者傳什麼就回什麼
                    TextMessage(text=event.message.text)  # 第二條訊息：再複製一次，這就是產生兩次回應的原因
                ]
            )
        )

# 如果是直接執行此腳本，則啟動 Flask 伺服器
if __name__ == "__main__":
    app.run(port=port)
